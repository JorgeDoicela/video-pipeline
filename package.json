{
  "name": "video-pipeline",
  "version": "1.0.0",
  "description": "Pipeline local de video programático con IA",
  "type": "module",
  "scripts": {
    "doctor": "hyperframes doctor",
    "preview": "hyperframes preview",
    "render": "hyperframes render",
    "check": "hyperframes check",
    "pipeline": "uv run python core/pipeline.py",
    "produce": "uv run python core/pipeline.py produce",
    "create": "uv run python core/pipeline.py scaffold",
    "styles": "uv run python core/pipeline.py style",
    "profiles": "uv run python core/pipeline.py profiles",
    "history": "uv run python core/pipeline.py history",
    "captions": "uv run python core/pipeline.py captions",
    "transcribe": "uv run python core/pipeline.py transcribe",
    "cut-silence": "uv run python core/pipeline.py cut",
    "assets": "uv run python core/pipeline.py assets",
    "image": "uv run python core/pipeline.py image",
    "sfx": "uv run python core/generate_sfx.py",
    "icons": "uv run python core/pipeline.py assets seed-icons",
    "models": "uv run python core/pipeline.py assets seed-models",
    "test:py": "uv run pytest tests",
    "lint:py": "uv run ruff check core tests",
    "format:py": "uv run ruff format core tests"
  },
  "dependencies": {
    "hyperframes": "0.9.18",
    "three": "^0.187.0"
  }
}
