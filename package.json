{
  "name": "video-pipeline",
  "version": "1.0.0",
  "description": "Pipeline local de video programático con IA",
  "type": "module",
  "scripts": {
    "doctor": "hyperframes doctor",
    "preview": "hyperframes preview",
    "render": "hyperframes render",
    "check": "hyperframes check",
    "pipeline": "python3 core/pipeline.py",
    "produce": "python3 core/pipeline.py produce",
    "create": "python3 core/pipeline.py scaffold",
    "styles": "python3 core/pipeline.py style",
    "captions": "python3 core/pipeline.py captions",
    "transcribe": "python3 core/pipeline.py transcribe",
    "cut-silence": "python3 core/pipeline.py cut",
    "assets": "python3 core/pipeline.py assets",
    "image": "python3 core/pipeline.py image",
    "sfx": "python3 core/generate_sfx.py",
    "icons": "python3 core/pipeline.py assets seed-icons",
    "test:py": "pytest tests",
    "lint:py": "ruff check core tests",
    "format:py": "ruff format core tests"
  },
  "dependencies": {
    "hyperframes": "0.9.18",
    "three": "^0.187.0"
  }
}
