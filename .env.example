# Variables de entorno opcionales para video-pipeline
# Copia este archivo a ".env" (ignorado por Git) y completa solo las que necesites.
# Las variables definidas en tu terminal o CI siempre tienen prioridad sobre ".env".

# Conector opcional Google Gemini API (pipeline.py genai ...)
# Obten tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Directorio externo opcional para separar tus producciones del motor (ej. ../video-studio)
VIDEO_PIPELINE_WORKSPACE=

# API key opcional de Freesound v2 para buscar SFX CC0 (assets audio --freesound)
FREESOUND_API_KEY=

# Ruta opcional al ejecutable de Blender si no esta en PATH (assets model --blender-script)
BLENDER_BIN=
