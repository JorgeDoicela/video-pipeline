# Normalizar finales de línea entre Linux (Debian/Nix) y Windows
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

*.mp4 binary
*.wav binary
*.png binary
*.jpg binary
*.woff2 binary
*.ttf binary
